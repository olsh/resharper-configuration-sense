<configuration>
  <appSettings>
    <add key="FirstSetting" value="1" />
    <add key="SecondSetting" value="2" />
  </appSettings>
  <connectionStrings>
    <add name="FirstConnection" connectionString="Data Source=first" />
    <add name="SecondConnection" connectionString="Data Source=second" />
  </connectionStrings>
</configuration>
